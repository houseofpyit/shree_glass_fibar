# Application
APP_NAME=ShreeGlassFiber
ENVIRONMENT=development
DEBUG=true
BASE_URL=http://192.168.1.2:8082
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shreeglass
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shreeglass
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Super Admin
SUPER_ADMIN_EMAIL=admin@shreeglass.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Upload
UPLOAD_PATH=uploads
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=20

# CORS
CORS_ORIGINS=["*"]

# Redis (Optional)
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Firebase (Push Notifications - placeholder)
FIREBASE_CREDENTIALS_PATH=

# App Version Control
ANDROID_MIN_VERSION=1.0.0
IOS_MIN_VERSION=1.0.0
FORCE_UPDATE=false
MAINTENANCE_MODE=false
